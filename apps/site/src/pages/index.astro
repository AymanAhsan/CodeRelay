---
import Layout from "../layouts/Layout.astro";
import handoffVideo from "../../../../docs/assets/team-handoff.webm?url";
import { REPOSITORY_URL, UPSTREAM_REPOSITORY_URL, WINDOWS_INSTALLER_URL, MAC_ARM64_INSTALLER_URL, MAC_X64_INSTALLER_URL, LINUX_X64_INSTALLER_URL, LINUX_ARM64_INSTALLER_URL, SITE_URL, SOURCE_ZIP_URL, QUICK_START_URL, TEAM_GUIDE_URL, HOSTING_GUIDE_URL } from "../lib/site";

const handoff = [
  { time: "09:41", who: "alice", verb: "owns", detail: "apps/web/**" },
  { time: "09:42", who: "bob", verb: "owns", detail: "apps/api/**" },
  { time: "09:44", who: "alice", verb: "proposes", detail: "Add dueAt to the invoices API", note: "Contract: contracts/invoices.md · pinned Git commit" },
  { time: "09:47", who: "bob", verb: "accepts", detail: "Agreed contract → local agent thread" },
  { time: "10:12", who: "bob", verb: "returns", detail: "API change ready to integrate", note: "Completion summary + branch + commit" },
];
---

<Layout title="CodeRelay | Hand work between your team's coding agents" description="Coordinate coding agents across your team with repository ownership, agreed contracts, and reviewed handoffs. Try CodeRelay's local two-teammate demo.">
  <div class="wrap">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="CodeRelay, home">
        <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="oklch(0.55 0.18 20)"></rect>
          <circle cx="9" cy="16" r="3" fill="#fff"></circle>
          <circle cx="23" cy="9" r="3" fill="#fff"></circle>
          <circle cx="23" cy="23" r="3" fill="#fff"></circle>
          <path d="M9 16 23 9M9 16l14 7" stroke="#fff" stroke-width="1.8" fill="none"></path>
        </svg>
        CodeRelay
      </a>
      <nav class="header-nav" aria-label="Primary">
        <a href={TEAM_GUIDE_URL}>Team guide</a>
        <a href={REPOSITORY_URL}>GitHub</a>
        <a href="#get-started">Get started</a>
      </nav>
    </header>
  </div>

  <main id="main">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title">Your agents can work as a team.</h1>
        <p class="lead">
          CodeRelay hands work between teammates' coding agents. Define who owns each part of the repo,
          agree on a contract, and send the task to the right person. Their agent returns a summary,
          branch, and commit for you to integrate.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={WINDOWS_INSTALLER_URL}>Download for Windows</a>
          <a class="button button--secondary" href="#get-started">Try the local demo</a>
        </div>
        <p class="fine">Also for macOS (<a href={MAC_ARM64_INSTALLER_URL}>Apple silicon</a>, <a href={MAC_X64_INSTALLER_URL}>Intel</a>) and Linux (<a href={LINUX_X64_INSTALLER_URL}>x64</a>, <a href={LINUX_ARM64_INSTALLER_URL}>arm64</a> AppImage). Or install from a terminal:</p>
        <p class="fine">macOS and Linux: <code>curl -fsSL {SITE_URL}/install.sh | bash</code><br />Windows PowerShell: <code>irm {SITE_URL}/install.ps1 | iex</code></p>
        <p class="fine">Builds are unsigned, so Windows may ask you to confirm before the installer runs. macOS blocks unsigned apps downloaded in a browser, so the terminal installer is the easiest way to install there. Open source under the MIT license. Bring your existing agent provider and subscription.</p>
      </div>
      <figure>
        <div class="feed" role="group" aria-label="Illustrated example of an Alice-to-Bob task handoff">
          <div class="feed-head">
            <strong>CodeRelay / invoice-app</strong>
            <span class="presence">Alice → Bob → Alice</span>
          </div>
          <ol class="feed-log">
            {handoff.map((row, i) => (
              <li class="feed-row" style={`--i:${i}`}>
                <span class="feed-time">{row.time}</span>
                <span class="feed-who">{row.who}</span>
                <span class="feed-verb">{row.verb}</span>
                <span class="feed-detail">{row.detail}{row.note && <em>{row.note}</em>}</span>
              </li>
            ))}
          </ol>
        </div>
        <figcaption class="feed-caption">An example handoff, from shared contract to completed work. Illustrative, not a live activity feed.</figcaption>
      </figure>
    </section>

    <section class="section" aria-labelledby="demo-title">
      <div class="wrap">
        <h2 id="demo-title">See a handoff between teammates</h2>
        <p class="section-intro">Bob's agent hands the backend work to Alice while it builds the frontend. Watch both sides in 68 seconds.</p>
        <figure class="handoff-demo">
          <video
            controls
            playsinline
            preload="none"
            poster="/team-handoff-poster.png"
            width="1920"
            height="1080"
            aria-label="CodeRelay demo: Bob hands a backend task to Alice"
            aria-describedby="demo-caption"
          >
            <source src={handoffVideo} type="video/webm" />
            <p><a href={handoffVideo}>Watch the handoff demo</a>.</p>
          </video>
          <figcaption class="feed-caption" id="demo-caption">A real two-teammate session, with on-screen explanations. <a href={handoffVideo}>Open the video full-size</a>.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="workflow-title">
      <div class="wrap">
        <h2 id="workflow-title">From “I need an API” to a change you can integrate</h2>
        <ol class="steps">
          <li class="step"><span class="step-n">1</span><div>
            <h3>Declare your areas</h3>
            <p>List the paths you own, such as <code>apps/api/**</code>, so agents can route work to you. They can also name a teammate explicitly.</p>
          </div></li>
          <li class="step"><span class="step-n">2</span><div>
            <h3>Agree on the contract</h3>
            <p>Push a spec or shared schema and pin the task to its Git commit. Both teammates agree on that version before acceptance.</p>
          </div></li>
          <li class="step"><span class="step-n">3</span><div>
            <h3>Accept into your own agent thread</h3>
            <p>Accept the task in chat or the Team hub to start a local agent thread working from the agreed contract.</p>
          </div></li>
          <li class="step"><span class="step-n">4</span><div>
            <h3>Review the result and integrate it</h3>
            <p>Fetch the returned branch and commit, review the summary and changes, then integrate. Reopen the task if it needs another pass.</p>
          </div></li>
        </ol>
        <p class="trust"><strong>You choose when work starts.</strong> Tasks normally wait for your acceptance. Optional automatic tasks let trusted teammates start eligible contract work, with a limit of three attempts and one automatic task in progress at a time. <a href={TEAM_GUIDE_URL + "#automatically-accepting-trusted-work"}>Read about automatic tasks</a>.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="boundary-title">
      <div class="wrap">
        <h2 id="boundary-title">Shared context. Your own agents.</h2>
        <p class="section-intro">A self-hosted hub connects your team. Each teammate's environment connects out to it and keeps running its own agents. If the hub goes offline, local agent work continues.</p>
        <div class="split">
          <div>
            <h3>In your environment</h3>
            <ul>
              <li><strong>Your coding agents</strong><span>Work with Codex, Claude Code, Cursor, Grok, OpenCode, or Antigravity.</span></li>
              <li><strong>Code and worktrees</strong><span>Contract files and completed changes travel through your Git remote. Teammates fetch the referenced commits.</span></li>
              <li><strong>Provider credentials</strong><span>Each teammate authenticates their own providers and uses their own subscriptions.</span></li>
              <li><strong>Agent conversations</strong><span>Full transcripts stay in your environment; the hub shares coordination updates.</span></li>
            </ul>
          </div>
          <div class="split--hub">
            <h3>Across the team</h3>
            <ul>
              <li><strong>Presence and ownership</strong><span>See who's online, whether their agents are running, and which repository areas they own.</span></li>
              <li><strong>Progress and file claims</strong><span>Share checkpoint summaries, branches, and paths touched. Claim paths to signal where an agent is working.</span></li>
              <li><strong>Interface changes</strong><span>Keep track of changes to routes, schemas, and types that other work depends on.</span></li>
              <li><strong>Tasks, contracts, and results</strong><span>Exchange suggestions and notes, agree on pinned contract references, and return completed work.</span></li>
            </ul>
          </div>
        </div>
        <p class="trust"><strong>Available where you work.</strong> Open the Team hub from the sidebar or command palette on web and desktop, or from Settings on mobile. Agents can coordinate through the team MCP tools. <a href={TEAM_GUIDE_URL}>Read the Team hub guide</a>.</p>
      </div>
    </section>

    <section class="section" id="get-started" aria-labelledby="start-title">
      <div class="wrap">
        <h2 id="start-title">Try both sides of a handoff</h2>
        <p class="section-intro">The local demo starts a hub and separate Alice and Bob sessions, already joined to a team. No Docker needed.</p>
        <div class="split">
          <div>
            <h3>Start the local demo</h3>
            <p class="setup-copy">On macOS or Linux, with Node.js 24 and Git installed, one command downloads the source and installs Vite+ (<code>vp</code>) if you need it. Install and authenticate a supported agent provider before starting agent work. <a href={QUICK_START_URL}>Read the installation steps</a>.</p>
            <pre class="install-code"><code>curl -fsSL {SITE_URL}/install.sh | bash -s -- --source
cd ~/CodeRelay
vp run dev:team</code></pre>
            <p class="setup-copy">Prefer not to use Git? <a href={SOURCE_ZIP_URL}>Download the latest source</a> as a zip, unzip it, and run <code>vp i</code> then <code>vp run dev:team</code> inside the folder.</p>
          </div>
          <div>
            <h3>Give Alice and Bob a task</h3>
            <p class="setup-copy">Open their labeled pairing URLs from the terminal. Set each teammate's owned paths under <strong>Your areas</strong>, then ask Alice's agent to propose work in Bob's area with a pushed contract.</p>
            <p class="setup-copy">Review and accept in Bob's session. When the work is complete, return to Alice to review the summary, branch, and commit.</p>
            <p class="setup-copy">Both demo sessions share the selected project's files. Press <kbd>Ctrl+C</kbd> in the launcher terminal to stop the demo.</p>
          </div>
        </div>
        <p class="trust"><strong>Run CodeRelay from this checkout.</strong> The application currently retains some upstream names and package identifiers. These instructions launch CodeRelay's Team hub workflow.</p>
      </div>
    </section>

    <section class="closer" aria-labelledby="closer-title">
      <div class="wrap">
        <h2 id="closer-title">Connect your teammates</h2>
        <p>Ready to work across machines? Self-host a hub, connect your team's Git repository, and invite your teammates. Share it over Tailscale or an address your team can reach.</p>
        <div class="button-row">
          <a class="button button--on-brand" href={HOSTING_GUIDE_URL}>Set up a team hub</a>
          <a class="button button--outline-on-brand" href={TEAM_GUIDE_URL}>Read the Team hub guide</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap site-footer">
    <p>CodeRelay is independently maintained and built on <a href={UPSTREAM_REPOSITORY_URL}>T3 Code</a> by T3 Tools Inc., under the MIT license. Not affiliated with or endorsed by T3 Tools.</p>
    <ul>
      <li><a href={REPOSITORY_URL}>CodeRelay on GitHub</a></li>
      <li><a href={REPOSITORY_URL + "/blob/main/LICENSE"}>License</a></li>
      <li><a href={REPOSITORY_URL + "/blob/main/NOTICE.md"}>Attribution</a></li>
    </ul>
  </footer>
</Layout>
